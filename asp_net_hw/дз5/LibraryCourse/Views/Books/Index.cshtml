@model List<Book>
@{ ViewData["Title"] = "Книги"; }
<div class="page-head"><h1>Каталог книг</h1><a class="button" asp-action="Create">Добавить книгу</a></div>
<form method="get" class="filters">
    <input name="search" value="@ViewBag.Search" placeholder="Название или автор" aria-label="Поиск книг" />
    <select name="genre" aria-label="Жанр"><option value="">Все жанры</option>
    @foreach (string genre in ViewBag.Genres)
    { <option value="@genre" selected="@(genre == (string?)ViewBag.Genre)">@genre</option> }
    </select><button type="submit">Найти</button><a asp-action="Index">Сбросить</a>
</form>
<div class="table-wrap"><table><thead><tr><th>Название</th><th>Автор</th><th>Жанр</th><th>Год</th><th>Доступно</th><th>Действия</th></tr></thead><tbody>
@foreach (var book in Model)
{
    var available = book.Copies - book.Loans.Count(l => l.ReturnedAt == null);
    <tr><td>@book.Title</td><td>@book.Author</td><td>@book.Genre</td><td>@book.Year</td><td>@available / @book.Copies</td>
    <td class="actions"><a asp-action="Edit" asp-route-id="@book.Id">Изменить</a>
    @if (available > 0) { <a asp-controller="Loans" asp-action="Create" asp-route-bookId="@book.Id">Выдать</a> }
    <a class="danger-text" asp-action="Delete" asp-route-id="@book.Id">Удалить</a></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="6">Книги не найдены.</td></tr> }
</tbody></table></div>