@model Book
@{ ViewData["Title"] = Model.Id == 0 ? "Добавить книгу" : "Изменить книгу"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Save" asp-route-id="@Model.Id" method="post" class="panel edit-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label asp-for="Title"></label><input asp-for="Title" required maxlength="150" /><span asp-validation-for="Title" class="validation"></span>
    <label asp-for="Author"></label><input asp-for="Author" required maxlength="100" /><span asp-validation-for="Author" class="validation"></span>
    <label asp-for="Genre"></label><input asp-for="Genre" required maxlength="50" /><span asp-validation-for="Genre" class="validation"></span>
    <label asp-for="Year"></label><input asp-for="Year" min="1450" max="2100" /><span asp-validation-for="Year" class="validation"></span>
    <label asp-for="Copies"></label><input asp-for="Copies" min="1" max="1000" /><span asp-validation-for="Copies" class="validation"></span>
    <div class="form-actions"><button type="submit">Сохранить</button><a asp-action="Index">Отмена</a></div>
</form>