@model List<Reader>
@{ ViewData["Title"] = "Читатели"; }
<div class="page-head"><h1>Читатели</h1><a class="button" asp-action="Create">Добавить читателя</a></div>
<form method="get" class="filters"><input name="search" value="@ViewBag.Search" placeholder="Имя или email" aria-label="Поиск читателей" />
<button type="submit">Найти</button><a asp-action="Index">Сбросить</a></form>
<div class="table-wrap"><table><thead><tr><th>ФИО</th><th>Email</th><th>Телефон</th><th>Книг на руках</th><th>Действия</th></tr></thead><tbody>
@foreach (var reader in Model)
{
    <tr><td>@reader.FullName</td><td>@reader.Email</td><td>@reader.Phone</td><td>@reader.Loans.Count(l => l.ReturnedAt == null)</td>
    <td class="actions"><a asp-action="Edit" asp-route-id="@reader.Id">Изменить</a><a class="danger-text" asp-action="Delete" asp-route-id="@reader.Id">Удалить</a></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5">Читатели не найдены.</td></tr> }
</tbody></table></div>