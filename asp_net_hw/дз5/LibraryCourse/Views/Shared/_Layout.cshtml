<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Библиотека</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <div class="nav-wrap">
        <a class="brand" asp-controller="Home" asp-action="Index">Библиотека</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav aria-label="Основное меню">
                <a asp-controller="Home" asp-action="Index">Главная</a>
                <a asp-controller="Books" asp-action="Index">Книги</a>
                <a asp-controller="Readers" asp-action="Index">Читатели</a>
                <a asp-controller="Loans" asp-action="Index">Выдачи</a>
            </nav>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="nav-button" type="submit">Выйти (@User.Identity.Name)</button>
            </form>
        }
    </div>
</header>
<main>
    @if (TempData["Message"] is string message)
    {
        <div class="notice" role="status">@message</div>
    }
    @RenderBody()
</main>
<footer>Учёт книг и читателей · @DateTime.Today.Year</footer>
</body>
</html>